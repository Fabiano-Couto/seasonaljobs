{
  "manifest_version": 3,
  "name": "Seasonal Jobs Monitor",
  "version": "1.2",
  "description": "Monitora vagas no SeasonalJobs.dol.gov e na CoolWorks.com e alerta o usuário rapidamente.",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://seasonaljobs.dol.gov/*",
    "https://api.seasonaljobs.dol.gov/*",
    "https://www.coolworks.com/*"
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://seasonaljobs.dol.gov/*",
        "https://*.coolworks.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ]
    }
  ]
}
